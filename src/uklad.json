    "text": {
      "section:nth-of-type(8) > div:nth-of-type(1) > div:nth-of-type(2) > h2:nth-of-type(1)": {
        "html": "Zajrzyj do nas!",
        "originalHtml": "Zajrzyj do nas."
      },
      "section:nth-of-type(5) > ul:nth-of-type(1) > li:nth-of-type(3) > p:nth-of-type(1)": {
        "html": "Wszystkie pomieszczenia naszego żłobka spełniają wszelkie normy wymagane przez sanepid. Sale zabaw wyposażone w najwyższej jakości zabawki oraz pomoce dydaktyczne pozwalają na bezpieczną zabawę i naukę. Wszystkie meble oraz akcesoria Misiów Tulisiów posiadają niezbędne atesty oraz certyfikaty,&nbsp;<div>aby móc bezpiecznie służyć potrzebom najmłodszych.</div>",
        "originalHtml": "Wszystkie pomieszczenia naszego żłobka spełniają wszelkie normy wymagane przez sanepid. Sale zabaw wyposażone w najwyższej jakości zabawki oraz pomoce dydaktyczne pozwalają na bezpieczną zabawę i naukę. Wszystkie meble oraz akcesoria Misiów Tulisiów posiadają niezbędne atesty oraz certyfikaty, aby móc bezpiecznie służyć potrzebom najmłodszych."
      },
      "section:nth-of-type(5) > ul:nth-of-type(1) > li:nth-of-type(2) > h2:nth-of-type(1)": {
        "html": "Różnorodne zajęcia rozwojowe",
        "originalHtml": "Różnorodne zajęcia rozwojowe."
      },
      "section:nth-of-type(5) > ul:nth-of-type(1) > li:nth-of-type(1) > h2:nth-of-type(1)": {
        "html": "Zdrowe posiłki każdego dnia",
        "originalHtml": "Zdrowe posiłki każdego dnia."
      },
      "section:nth-of-type(5) > ul:nth-of-type(1) > li:nth-of-type(3) > h2:nth-of-type(1)": {
        "html": "Odpowiednio wyposażone sale",
        "originalHtml": "Odpowiednio wyposażone sale."
      },
      "section:nth-of-type(5) > ul:nth-of-type(1) > li:nth-of-type(4) > h2:nth-of-type(1)": {
        "html": "Zaufane i doświadczone opiekunki",
        "originalHtml": "Zaufane i doświadczone opiekunki."
      },
      "section:nth-of-type(7) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(2) > p:nth-of-type(1)": {
        "html": "Misie Tulisie to przestrzeń, w której zdajemy sobie sprawę,&nbsp;<div>że<!-- --> <strong class=\"font-semibold text-foreground\">dzieciństwo jest naprawdę ważne</strong>, a rodzice mogą mieć pewność, że ich dziecko jest w dobrych rękach.</div>",
        "originalHtml": "Misie Tulisie to przestrzeń, w której zdajemy sobie sprawę, że<!-- --> <strong class=\"font-semibold text-foreground\">dzieciństwo jest naprawdę ważne</strong>, a rodzice mogą mieć pewność, że ich dziecko jest w dobrych rękach."
      },
      "section:nth-of-type(4) > div:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1)": {
        "html": "Misie Tulisie działają w oparciu o aktualne podstawy programowe&nbsp;<div>oraz wartości zawarte w <strong class=\"font-semibold text-foreground\">Konwencji o prawach dziecka</strong>,&nbsp;</div><div>w szczególności prawo dziecka do:</div>",
        "originalHtml": "Misie Tulisie działają w oparciu o aktualne podstawy programowe oraz wartości zawarte w <strong class=\"font-semibold text-foreground\">Konwencji o prawach dziecka</strong>, w szczególności prawo dziecka do:"
      },
      "section:nth-of-type(3) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1)": {
        "html": "Misie Tulisie to wyjątkowe miejsce stworzone z myślą o najmłodszych&nbsp;<div>i ich naturalnej potrzebie poznawania świata. Dbamy o to, aby każde dziecko czuło się u nas<!-- --> <strong class=\"font-semibold text-foreground\">bezpiecznie i swobodnie</strong>, a każdy dzień był pełen radości, nowych doświadczeń i małych odkryć. Tworzymy ciepłą, przyjazną atmosferę, w której dzieci mogą rozwijać się we własnym tempie, budować pierwsze relacje z rówieśnikami i stopniowo zdobywać nowe umiejętności.</div>",
        "originalHtml": "Misie Tulisie to wyjątkowe miejsce stworzone z myślą o najmłodszych i ich naturalnej potrzebie poznawania świata. Dbamy o to, aby każde dziecko czuło się u nas<!-- --> <strong class=\"font-semibold text-foreground\">bezpiecznie i swobodnie</strong>, a każdy dzień był pełen radości, nowych doświadczeń i małych odkryć. Tworzymy ciepłą, przyjazną atmosferę, w której dzieci mogą rozwijać się we własnym tempie, budować pierwsze relacje z rówieśnikami i stopniowo zdobywać nowe umiejętności."
      },
      "section:nth-of-type(3) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(2)": {
        "html": "Nasze opiekunki z troską i uważnością wspierają maluchy&nbsp;<div>w codziennym rozwoju, wykorzystując ich naturalną ciekawość i chęć poznawania otaczającego świata.</div>",
        "originalHtml": "Nasze opiekunki z troską i uważnością wspierają maluchy w codziennym rozwoju, wykorzystując ich naturalną ciekawość i chęć poznawania otaczającego świata."
      },
      "section:nth-of-type(1) > div:nth-of-type(1) > h1:nth-of-type(1)": {
        "html": "Ciepło, spokój i uważność ...",
        "originalHtml": "Ciepło, spokój i uważność."
      },
      "section:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > h2:nth-of-type(1)": {
        "html": "Żłobek to coś więcej niż opieka",
        "originalHtml": "Żłobek to coś więcej niż opieka."
      },
      "section:nth-of-type(6) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > h2:nth-of-type(1)": {
